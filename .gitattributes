# Let Git normalize line endings consistently
* text=auto

# Keep these as LF in the repo (best for cross-platform)
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.gradle text eol=lf
*.kts  text eol=lf

# Windows scripts should stay CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binary files (never touch line endings)
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary