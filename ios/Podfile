# Minimum iOS version for all pods
platform :ios, '16.2'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.2'
    end
  end

  # Link libc++ explicitly on the app target.
  #
  # Sentry compiles C++ (SentryBacktrace, SentryCrashMonitor_CPPException,
  # SentryThreadMetadataCache, SentryContinuousProfiler) but its podspec declares
  # CLANG_CXX_LIBRARY only in pod_target_xcconfig and declares no `libraries`, so
  # CocoaPods never propagates libc++ to the app target. Below the 16.2 raise it
  # still arrived, via auto-link requests clang emitted into the pod's object
  # files; at 16.2 clang stops emitting them and the Release link fails with a
  # page of undefined C++ runtime symbols (operator new, __cxa_*,
  # __gxx_personality_v0, std::__1::mutex::lock).
  #
  # So the app was only ever linking libc++ by accident. This states it.
  #
  # ⚠️ DO NOT REMOVE. It looks like a stray flag with no owner in this project —
  # nothing in ios/ or lib/ contains a line of C++. The owner is a transitive
  # dependency, and the failure it prevents is a link error, not a warning.
  # $(inherited) is load-bearing: without it this replaces the whole framework
  # list CocoaPods puts in Pods-Runner.<config>.xcconfig.
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      next unless target.name == 'Runner'
      target.build_configurations.each do |config|
        config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -lc++'
      end
    end
    aggregate_target.user_project.save
  end

  ################  Awesome Notifications pod modification 1 ###################
  awesome_pod_file = File.expand_path(File.join('plugins', 'awesome_notifications', 'ios', 'Scripts', 'AwesomePodFile'), '.symlinks')
  require awesome_pod_file
  update_awesome_pod_build_settings(installer)
  ################  Awesome Notifications pod modification 1 ###################
end

################  Awesome Notifications pod modification 2 ###################
awesome_pod_file = File.expand_path(File.join('plugins', 'awesome_notifications', 'ios', 'Scripts', 'AwesomePodFile'), '.symlinks')
require awesome_pod_file
update_awesome_main_target_settings('Runner', File.dirname(File.realpath(__FILE__)), flutter_root)
################  Awesome Notifications pod modification 2 ###################
